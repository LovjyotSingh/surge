.claude/worktrees/
# docker/gen-secrets.sh output: credentials, JWT and internal identity keys, Redis ACL, RabbitMQ definitions.
docker/secrets/
# docker/gen-selfsigned-cert.sh output (compose.tls-local.yaml): a certificate and its private key.
docker/tls/
*.pem
