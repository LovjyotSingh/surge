<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.9</version>
        <relativePath/>
    </parent>
    <groupId>dev.surge</groupId>
    <artifactId>surge</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>surge</name>

    <properties>
        <java.version>25</java.version>
        <springdoc.version>3.0.3</springdoc.version>

        <!-- S9b: security overrides of Spring Boot managed versions (see docs/security/accepted-risks.md) -->
        <rabbit-amqp-client.version>5.37.1</rabbit-amqp-client.version>
        <httpcore5.version>5.4.3</httpcore5.version>
        <httpclient5.version>5.6.3</httpclient5.version>

        <!-- S2a: common's internal identity tokens use Nimbus directly. Not managed by the Boot BOM; keep equal to the
             version spring-security-oauth2-jose (Spring Security ${spring-security.version}) declares. -->
        <nimbus-jose-jwt.version>10.4</nimbus-jose-jwt.version>
    </properties>

    <modules>
        <module>common</module>
        <module>outbox</module>
        <module>discovery</module>
        <module>config-server</module>
        <module>booking-service</module>
        <module>auth-service</module>
        <module>catalog-service</module>
        <module>payment-service</module>
        <module>notification-service</module>
        <module>gateway</module>
        <module>tools/loadtest</module>
        <module>tools/smoke</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- S9b: not managed by the Boot BOM; pinned here, declared before the BOM imports. -->
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>1.1.10.12</version>
            </dependency>
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>1.11.4</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.7.2-jre</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpclient</artifactId>
                <version>4.5.14</version>
            </dependency>
            <dependency>
                <groupId>com.nimbusds</groupId>
                <artifactId>nimbus-jose-jwt</artifactId>
                <version>${nimbus-jose-jwt.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>2025.1.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
