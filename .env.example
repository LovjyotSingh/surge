# Placeholders only. Do not fill this in by hand: run docker/gen-secrets.sh, which writes .env (mode 600) with the
# lines below, and every password and key as its own file in docker/secrets/ (S10: compose mounts each one as a
# secret; no password is ever an environment variable). docker compose refuses to start while any of these is empty.

EUREKA_USER=
CONFIG_USER=
SURGE_ADMIN_EMAIL=

# Not generated. compose.dev.yaml points mail at Mailpit and S3 at S3Mock. compose.prod.yaml needs real ones, plus
# docker/secrets/mail_password and real keys in docker/secrets/s3_access_key and s3_secret_key (docs/DEPLOY.md):
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_FROM=Surge <tickets@example.com>
# S3_ENDPOINT=          (empty = AWS)
# S3_REGION=ap-south-1
# S3_BUCKET=surge-tickets
# PUBLIC_BASE_URL=https://example.com
